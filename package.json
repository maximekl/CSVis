{
  "name": "csvis",
  "displayName": "CSVis",
  "version": "1.0.0",
  "publisher": "MaximeK",
  "private": true,
  "description": "A read-only CSV table viewer with DuckDB SQL support for Cursor and VS Code.",
  "pricing": "Free",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maximekl/CSVis.git"
  },
  "icon": "images/icon.png",
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "csv",
    "duckdb",
    "sql",
    "table"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCustomEditor:csvis.csvViewer",
    "onCommand:csvis.openCsvAsTable"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "csvis.csvViewer",
        "displayName": "CSVis CSV Viewer",
        "selector": [
          {
            "filenamePattern": "*.csv"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "csvis.openCsvAsTable",
        "title": "Open CSV as Table",
        "category": "CSVis"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc && npm run build:webview && npm run build:extension",
    "build:webview": "node scripts/build-webview.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "package": "node scripts/package-vsix.mjs",
    "package:macos": "node scripts/package-vsix.mjs darwin-arm64",
    "package:linux": "node scripts/package-vsix.mjs linux-x64",
    "package:windows": "node scripts/package-vsix.mjs win32-x64",
    "package:all": "node scripts/package-vsix.mjs all",
    "verify:package": "node scripts/verify-vsix.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "test": "npm run compile && npm run test:unit && node dist/scripts/run-integration-tests.js",
    "test:unit": "node --test dist/test/*.test.js",
    "test:integration": "npm run compile && node dist/scripts/run-integration-tests.js",
    "test:performance": "npm run compile && node dist/scripts/run-performance-tests.js",
    "test:duckdb": "npm run compile && node --test dist/test/duckdbAdapter.test.js",
    "test:csv": "npm run compile && node --test dist/test/csv*.test.js",
    "test:query": "npm run compile && node --test dist/test/query*.test.js",
    "test:serialization": "npm run compile && node --test dist/test/resultSerializer.test.js",
    "test:session": "npm run compile && node --test dist/test/csvSession.test.js",
    "test:webview": "npm run compile && node --test dist/test/webview.test.js",
    "test:grid": "npm run compile && node --test dist/test/dataGrid.test.js",
    "test:console": "npm run compile && node --test dist/test/sqlConsole.test.js",
    "test:settings": "npm run compile && node --test dist/test/csvSettings.test.js",
    "test:file": "npm run compile && node --test dist/test/csvFileMonitor.test.js",
    "test:security": "npm run compile && node --test dist/test/security.test.js"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.5"
  }
}
